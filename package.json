{
  "name": "ripit",
  "version": "1.2.0",
  "main": "main.js",
  "author":"alkemist",
  "description": "something",
  "scripts": {
    "start": "electron .",
    "dev": "electronmon .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "electronmon": {
    "patterns": [
      "!data/**", 
      "!**.db",
      "*.js",
      "*.html",
      "*.css",
      "server.py"
    ]    
  },
  "build": {
    "asar":true,
    "appId": "com.ripit.app",
    "productName": "RipIt",
    "files": [
      "main.js",
      "app.js",
      "style.css",
      "preload.js",
      "views/**"
    ],
    "extraResources": [
      {
        "from": "resources/win/server.exe",
        "to": "server.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "resources/win/server.exe",
          "to": "server.exe"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "extraResources": [
        {
          "from": "server",
          "to": "server"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^24.13.3",
    "electronmon": "^2.0.4"
  }
}
